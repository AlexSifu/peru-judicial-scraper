# URL base del portal (sin slash final)
BASE_URL=https://jurisprudencia.pj.gob.pe/jurisprudenciaweb

# Directorios de salida
OUTPUT_DIR=./data
PDF_DIR=./data/pdfs

# HTTP
REQUEST_TIMEOUT_MS=30000
REQUEST_DELAY_MS=1000

# Reintentos ante 429 / errores transitorios
MAX_RETRIES=5
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=60000

# Límites opcionales para ejecuciones de prueba (vacío = sin límite)
MAX_PAGES=
MAX_DOCUMENTS=

# Descargar PDFs (true/false)
DOWNLOAD_PDFS=true

# Criterios de búsqueda (el portal exige al menos uno).
# SEARCH_YEAR: año de la resolución. SEARCH_TEXT: texto libre opcional.
SEARCH_YEAR=2024
SEARCH_TEXT=

# Nivel de log: info | debug
LOG_LEVEL=info
